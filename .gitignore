# Nova ignore policy
#
# - data/ and runs/: folders stay visible in the repository (directory entries
#   kept with README.md placeholders); only heavy file contents are excluded
#   by the file-type rules below.
# - legacy/ and background/ (user decision 2026-11-03): kept OUT of the
#   repository entirely. They exist locally so development can inherit
#   information from the previous version (read-only reference material).
# - Venvs are opaque: contents excluded, only the top-level README.md kept.

# --- Read-only upstream reference material (stays local, not in the repo) ---
legacy/
background/

# --- Regenerable Python / build / local-env artifacts ---
__pycache__/
*.py[cod]
*.egg-info/
*.egg-info/**
.cache/
*.cache/

# --- Data and run artifacts, excluded by file type (not by folder) ---
*.parquet
*.duckdb
*.duckdb.wal
*.csv
*.npy
*.zip
*.gz
*.so
*.log
*.pyf
*.pxd
*.pyi

# --- Keep folder placeholders and human-readable metadata visible ---
!README.md
!*.md
!*.json
!*.yaml
!*.yml
!*.txt

# --- Venvs: subdirectories ignored as a unit, root files ignored, then the
#     venv's top-level README.md placeholder is re-allowed. ---
.venv/bin/
.venv/lib/
.venv/include/
.venv/share/
.venv/pyvenv.cfg
.venv/CACHEDIR.TAG
venv/bin/
venv/lib/
venv/include/
venv/share/
venv/pyvenv.cfg
venv/CACHEDIR.TAG
!/.venv/README.md
!/venv/README.md
